{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "enableWeakerNestedSandbox": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "strictAllowlist": true,
      "allowedDomains": ["repo.maven.apache.org"]
    },
    "filesystem": {
      "allowWrite": ["~/.m2"]
    }
  },
  "env": {
    "MAVEN_ARGS": "-s .harness/sandbox/maven-settings.xml"
  }
}
